# Copy to .env and load with:  set -a; source .env; set +a
ANTHROPIC_API_KEY=your-key-here

# Model used by the agent loop (any Claude model ID that supports tool use)
SALESPREP_MODEL=claude-sonnet-5-5

# fixture = offline synthetic web pages (default, safe for demos)
# live    = fetch pages from the lead's own domain only (SSRF-guarded)
SALESPREP_WEB=fixture

# Shared secret for the webhook trigger (`salesprep serve` refuses to start without it)
WEBHOOK_SECRET=change-me
